# Copy this file to `.env` and replace the example values with your real credentials.
# Application environment
NODE_ENV=development
PORT=5000

# PostgreSQL database
# Requires PostgreSQL 15+.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devjudge_db"

# Password hashing
BCRYPT_SALT_ROUNDS=12

# JWT config
JWT_SECRET="devjudge_super_secret_access_key_change_me"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="devjudge_super_secret_refresh_key_change_me"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Stripe config
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
CLIENT_URL="http://localhost:3000"
